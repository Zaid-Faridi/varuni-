# =================================================================
# VARUNI Environment Configuration
# =================================================================

# Database Configuration (PostgreSQL 16 with PostGIS 3.4)
POSTGRES_USER=watershed_user
POSTGRES_PASSWORD=replace_with_secure_database_password
POSTGRES_DB=watershed_db
DB_PORT=5432
DATABASE_URL=postgresql://watershed_user:replace_with_secure_database_password@localhost:5432/watershed_db

# JWT Authentication Secret Key (Required, minimum 32 characters)
# Generate a secret key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrator Account
# When DEMO_MODE=0, ADMIN_PASSWORD is required and must be at least 12 characters
ADMIN_EMAIL=admin@watershed.gov.in
ADMIN_USERNAME=admin
ADMIN_FULL_NAME="System Administrator"
ADMIN_PASSWORD=

# Demonstration Mode (0 = production, 1 = demo mode)
DEMO_MODE=0

# Optional demo role account passwords (only active when DEMO_MODE=1)
# If left blank in DEMO_MODE=1, secure random passwords are generated and printed to the server log
DEMO_ANALYST_PASSWORD=
DEMO_OFFICER_PASSWORD=
DEMO_REVIEWER_PASSWORD=

# API & Server Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3033,http://127.0.0.1:3000,http://127.0.0.1:3033
PORT=8000
DATA_DIR=./data

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bhuvan LULC Provider (Secrets in .env)
BHUVAN_LULC_TOKEN_A=
BHUVAN_LULC_TOKEN_B=
LULC_AREA_UNITS=unverified
LULC_VINTAGE=year not stated
